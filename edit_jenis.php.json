<?php
include 'koneksi.php';

$id = (int) $_GET['id'];
$result = mysqli_query($conn, "SELECT * FROM jenis_pelanggan WHERE id_jenis = $id");
$data = mysqli_fetch_assoc($result);

if (!$data) {
        die("Data jenis pelanggan tidak ditemukan.");
}

if (isset($_POST['update'])) {
        $jenis = mysqli_real_escape_string($conn, $_POST['jenis']);
            $sql   = "UPDATE jenis_pelanggan SET jenis = '$jenis' WHERE id_jenis = $id";

                if (mysqli_query($conn, $sql)) {
                            header("Location: jenis_pelanggan.php");
                                    exit;
                } else {
                            echo "Gagal mengubah data: " . mysqli_error($conn);
                }
}
