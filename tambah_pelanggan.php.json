<?php
include 'koneksi.php';

$jenis_list = mysqli_query($conn, "SELECT * FROM jenis_pelanggan ORDER BY jenis ASC");

if (isset($_POST['simpan'])) {
        $id_jenis       = (int) $_POST['id_jenis'];
            $nama_pelanggan = mysqli_real_escape_string($conn, $_POST['nama_pelanggan']);
                $alamat         = mysqli_real_escape_string($conn, $_POST['alamat']);
                    $no_handphone   = mysqli_real_escape_string($conn, $_POST['no_handphone']);

                        $sql = "INSERT INTO pelanggan (id_jenis, nama_pelanggan, alamat, no_handphone) 
                                    VALUES ($id_jenis, '$nama_pelanggan', '$alamat', '$no_handphone')";

                                        if (mysqli_query($conn, $sql)) {
                                                    header("Location: pelanggan.php");
                                                            exit;
                                        } else {
                                                    echo "Gagal menambah data: " . mysqli_error($conn);
                                        }
}
