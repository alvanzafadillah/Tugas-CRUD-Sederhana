<?php
include 'koneksi.php';

$id = (int) $_GET['id'];
$pelanggan = mysqli_query($conn, "SELECT * FROM pelanggan WHERE id_pelanggan = $id");
$data = mysqli_fetch_assoc($pelanggan);

if (!$data) {
        die("Data pelanggan tidak ditemukan.");
}

$jenis_list = mysqli_query($conn, "SELECT * FROM jenis_pelanggan ORDER BY jenis ASC");

if (isset($_POST['update'])) {
        $id_jenis       = (int) $_POST['id_jenis'];
            $nama_pelanggan = mysqli_real_escape_string($conn, $_POST['nama_pelanggan']);
                $alamat         = mysqli_real_escape_string($conn, $_POST['alamat']);
                    $no_handphone   = mysqli_real_escape_string($conn, $_POST['no_handphone']);

                        $sql = "UPDATE pelanggan 
                                    SET id_jenis = $id_jenis, nama_pelanggan = '$nama_pelanggan', alamat = '$alamat', no_handphone = '$no_handphone' 
                                                WHERE id_pelanggan = $id";

                                                    if (mysqli_query($conn, $sql)) {
                                                                header("Location: pelanggan.php");
                                                                        exit;
                                                    } else {
                                                                echo "Gagal mengubah data: " . mysqli_error($conn);
                                                    }
}
?>

