CREATE DATABASE IF NOT EXISTS web1_pertemuan09
CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE web1_pertemuan09;

CREATE TABLE kategori (
        id_kategori INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
            nama_kategori VARCHAR(80) NOT NULL UNIQUE
) ENGINE=InnoDB;

CREATE TABLE produk (
        id_produk INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
            id_kategori INT UNSIGNED NOT NULL,
                nama_produk VARCHAR(120) NOT NULL,
                    harga DECIMAL(12,2) NOT NULL,
                        stok INT UNSIGNED NOT NULL DEFAULT 0,
                            CONSTRAINT fk_produk_kategori
                                FOREIGN KEY (id_kategori) REFERENCES kategori (id_kategori)
                                    ON UPDATE CASCADE ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE jenis_pelanggan (
        id_jenis INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
            jenis VARCHAR(50) NOT NULL UNIQUE
) ENGINE=InnoDB;

CREATE TABLE pelanggan (
        id_pelanggan INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
            id_jenis INT UNSIGNED NOT NULL,
                nama_pelanggan VARCHAR(120) NOT NULL,
                    alamat TEXT NOT NULL,
                        no_handphone VARCHAR(20) NOT NULL,
                            CONSTRAINT fk_pelanggan_jenis
                                FOREIGN KEY (id_jenis) REFERENCES jenis_pelanggan (id_jenis)
                                    ON UPDATE CASCADE ON DELETE RESTRICT
) ENGINE=InnoDB;

